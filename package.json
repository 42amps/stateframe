{
  "name": "stateframe",
  "version": "0.1.0",
  "description": "A file-first task-state ledger for long-horizon agent workflows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/42amps/stateframe.git"
  },
  "bugs": {
    "url": "https://github.com/42amps/stateframe/issues"
  },
  "homepage": "https://github.com/42amps/stateframe#readme",
  "keywords": [
    "ai-agents",
    "llm",
    "cli",
    "task-state",
    "handoff",
    "long-horizon-agents",
    "agent-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "stateframe": "./dist/cli/index.js",
    "ledger": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "examples",
    "task.ledger.schema.json"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:cli && next build",
    "build:cli": "node scripts/build-cli.mjs",
    "stateframe": "tsx cli/index.ts",
    "ledger": "tsx cli/index.ts",
    "start": "next start",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
