[0.8,"o","===================\r\n  Stateframe Demo\r\n===================\r\n\r\nCreated demo ledger in ledger-demo\r\n\r\nFiles created:\r\n- ledger-demo/transcript.txt\r\n- ledger-demo/candidates.json\r\n- ledger-demo/task.ledger.json\r\n- ledger-demo/handoff.md\r\n\r\nInspect the handoff: ledger-demo/handoff.md\r\nSuggested next step: Paste handoff.md into a fresh AI agent session and ask it to continue the task.\r\n"]
